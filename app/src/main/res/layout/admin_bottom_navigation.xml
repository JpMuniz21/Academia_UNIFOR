<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/admin_outline" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView style="@style/AdminText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/admin_navigation_active" android:text="@string/admin_home" android:layout_weight="1" android:minHeight="60dp" android:gravity="center" android:drawablePadding="4dp" android:paddingVertical="8dp" app:drawableTopCompat="@drawable/admin_ic_home" app:drawableTint="@color/admin_navigation_active" />
        <TextView style="@style/AdminText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/admin_text" android:text="@string/admin_agenda" android:layout_weight="1" android:minHeight="60dp" android:gravity="center" android:drawablePadding="4dp" android:paddingVertical="8dp" app:drawableTopCompat="@drawable/admin_ic_agenda" app:drawableTint="@color/admin_text" />
        <FrameLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1">
            <ImageView android:id="@+id/navigation_ai" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:contentDescription="@string/admin_ai" android:padding="10dp" android:src="@drawable/admin_ic_ai" android:background="@drawable/admin_ai_background" />
        </FrameLayout>
        <TextView style="@style/AdminText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/admin_text" android:text="@string/admin_workouts" android:layout_weight="1" android:minHeight="60dp" android:gravity="center" android:drawablePadding="4dp" android:paddingVertical="8dp" app:drawableTopCompat="@drawable/admin_ic_workouts" app:drawableTint="@color/admin_text" />
        <TextView style="@style/AdminText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/admin_text" android:text="@string/admin_profile" android:layout_weight="1" android:minHeight="60dp" android:gravity="center" android:drawablePadding="4dp" android:paddingVertical="8dp" app:drawableTopCompat="@drawable/admin_ic_profile" app:drawableTint="@color/admin_text" />
    </LinearLayout>
</LinearLayout>