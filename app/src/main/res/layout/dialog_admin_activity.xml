<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/admin_card_background"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/admin_card_padding">

        <TextView android:id="@+id/heading" style="@style/AdminText.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_next_activity" />

        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <EditText
                android:id="@+id/title"
                style="@style/AdminText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"
                android:padding="0dp"
                android:background="@null"
                android:hint="@string/admin_title_hint"
                android:textColorHint="@color/admin_text_secondary"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="2"
                android:scrollHorizontally="false"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:selectAllOnFocus="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/time"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Aula Funcional" />
            <TextView
                android:id="@+id/time"
                style="@style/AdminText.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_time_functional"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include android:id="@+id/stats" layout="@layout/admin_activity_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/AdminText.Heading" android:textSize="12sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_teacher_label" android:labelFor="@id/teacher_selector" />
            <TextView android:id="@+id/teacher_selector" style="@style/AdminSelector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="@string/admin_substitute_teacher" />
        </LinearLayout>
        <TextView android:id="@+id/teacher" style="@style/AdminText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:text="@string/admin_teacher_lorena" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/AdminText.Heading" android:textSize="12sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_capacity_label" android:labelFor="@id/capacity_selector" />
            <TextView android:id="@+id/capacity_selector" style="@style/AdminSelector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="@string/admin_choose_capacity" android:visibility="gone" tools:visibility="visible" />
        </LinearLayout>
        <TextView android:id="@+id/capacity" style="@style/AdminText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="11sp" android:text="@string/admin_capacity_functional" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/AdminText.Heading" android:textSize="12sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_status_label" android:labelFor="@id/status_selector" />
            <TextView android:id="@+id/status_selector" style="@style/AdminSelector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="@string/admin_status_scheduled" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/cancel" style="@style/AdminButton.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/admin_cancel_activity" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/primary_action" style="@style/AdminButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="32dp" android:text="@string/admin_collapse_activity" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" android:src="@drawable/admin_ic_up" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
